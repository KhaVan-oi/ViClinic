@startuml

title ERD - ViClinic

skinparam linetype ortho
hide circle

entity "doctor_shifts" as DOCTOR_SHIFTS {
  *shift_id : INTEGER <<PK>>
  --
  doctor_id : INTEGER <<FK>>
  start_at : TIMESTAMPTZ
  end_at : TIMESTAMPTZ
}

entity "doctor_unavailability" as DOCTOR_UNAVAILABILITY {
  *unavailability_id : INTEGER <<PK>>
  --
  doctor_id : INTEGER <<FK>>
  start_at : TIMESTAMPTZ
  end_at : TIMESTAMPTZ
}

entity "user_roles" as USER_ROLES {
  *user_id : INTEGER <<PK, FK>>
  *role : VARCHAR(30) <<PK>>
}

entity "accounts" as ACCOUNTS {
  *account_id : INTEGER <<PK>>
  --
  user_id : INTEGER <<FK,UQ>>
  password_hash : VARCHAR(255) NULL
  status : VARCHAR(30)
}

entity "auth_sessions" as AUTH_SESSIONS {
  *session_id : BIGINT <<PK>>
  --
  account_id : INTEGER <<FK>>
  token_hash : VARCHAR(128) <<UQ>>
  created_at : TIMESTAMPTZ
  expires_at : TIMESTAMPTZ
  revoked_at : TIMESTAMPTZ NULL
}

entity "otp_challenges" as OTP_CHALLENGES {
  *challenge_id : UUID <<PK>>
  --
  account_id : INTEGER <<FK, NULL>>
  phone : VARCHAR(20)
  purpose : VARCHAR(30)
  code_digest : VARCHAR(128)
  created_at : TIMESTAMPTZ
  expires_at : TIMESTAMPTZ
  attempt_count : INTEGER
  consumed_at : TIMESTAMPTZ NULL
}

entity "users" as USERS {
  *user_id : INTEGER <<PK>>
  --
  full_name : VARCHAR(120)
  birth_date : DATE NULL
  phone : VARCHAR(20) <<UQ>>
  email : VARCHAR(120) <<UQ>> NULL
}

entity "doctor_services" as DOCTOR_SERVICES {
  *doctor_id : INTEGER <<PK, FK>>
  *service_id : INTEGER <<PK, FK>>
}

entity "appointment_history" as APPOINTMENT_HISTORY {
  *history_id : INTEGER <<PK>>
  --
  appointment_id : INTEGER <<FK>>
  actor_user_id : INTEGER <<FK>>
  old_doctor_id : INTEGER <<FK, NULL>>
  new_doctor_id : INTEGER <<FK, NULL>>
  old_service_id : INTEGER <<FK, NULL>>
  new_service_id : INTEGER <<FK, NULL>>
  changed_at : TIMESTAMPTZ
  old_status : VARCHAR(20) NULL
  new_status : VARCHAR(20)
  old_start_at : TIMESTAMPTZ NULL
  new_start_at : TIMESTAMPTZ NULL
  old_end_at : TIMESTAMPTZ NULL
  new_end_at : TIMESTAMPTZ NULL
}

entity "appointments" as APPOINTMENTS {
  *appointment_id : INTEGER <<PK>>
  --
  patient_id : INTEGER <<FK>>
  service_id : INTEGER <<FK>>
  doctor_id : INTEGER <<FK, NULL>>
  start_at : TIMESTAMPTZ
  end_at : TIMESTAMPTZ
  status : VARCHAR(20)
}

entity "notifications" as NOTIFICATIONS {
  *notification_id : INTEGER <<PK>>
  --
  appointment_id : INTEGER <<FK>>
  recipient_user_id : INTEGER <<FK>>
  content : TEXT
  created_at : TIMESTAMPTZ
  read_at : TIMESTAMPTZ NULL
}

entity "services" as SERVICES {
  *service_id : INTEGER <<PK>>
  --
  name : VARCHAR(120)
  duration_minutes : INTEGER
  is_active : BOOLEAN
}

DOCTOR_SHIFTS }o--|| USERS : "doctor"
DOCTOR_UNAVAILABILITY }o--|| USERS : "doctor"
USER_ROLES }o--|| USERS : "user"

ACCOUNTS |o--|| USERS : "user"
ACCOUNTS ||--o{ AUTH_SESSIONS : "account"
ACCOUNTS |o--o{ OTP_CHALLENGES : "account"
USERS ||--o{ DOCTOR_SERVICES : "doctor"

USERS ||--o{ APPOINTMENT_HISTORY : "actor / doctor"
USERS ||--o{ APPOINTMENTS : "patient / doctor"
USERS ||--o{ NOTIFICATIONS : "recipient"

APPOINTMENT_HISTORY }o--|| APPOINTMENTS : "appointment"
APPOINTMENTS ||--o{ NOTIFICATIONS : "appointment"

APPOINTMENTS }o--|| SERVICES : "service"
DOCTOR_SERVICES }o--|| SERVICES : "service"
APPOINTMENT_HISTORY }o--o| SERVICES : "old_service /\nnew_service"

@enduml
