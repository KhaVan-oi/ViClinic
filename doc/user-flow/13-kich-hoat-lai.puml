@startuml
title UF-13. Kích hoạt lại tài khoản
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 0
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle diamond
start
:Admin chọn account DISABLED;
:Cho phép kích hoạt lại;
:Chuyển account sang PENDING_ACTIVATION;
:Chính chủ đăng nhập đúng mật khẩu;
:Gửi OTP kích hoạt lại đến SĐT;
:Chính chủ nhập OTP;
if (OTP hợp lệ?) then (Có)
  :Chuyển account sang ACTIVE;
else (Không)
  :Giữ account PENDING_ACTIVATION;
endif
stop
@enduml
