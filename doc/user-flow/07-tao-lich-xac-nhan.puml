@startuml
title UF-07. Lễ tân tạo lịch đã xác nhận
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 0
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle diamond
start
:Lễ tân tra cứu bệnh nhân bằng SĐT;
if (Có hồ sơ?) then (Có)
else (Không)
  :Tạo hồ sơ bệnh nhân;
endif
:Chọn dịch vụ, bác sĩ và thời gian;
:Hệ thống kiểm tra điều kiện lịch;
if (Hợp lệ?) then (Có)
  :Tạo lịch CONFIRMED;
else (Không)
  :Không tạo lịch;
endif
stop
@enduml
