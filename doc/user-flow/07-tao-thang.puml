@startuml
title UF-07. Lễ tân tạo lịch đã xác nhận

skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 0
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle diamond

start
:Lễ tân nhập SĐT bệnh nhân;
:Hệ thống tra cứu Patient Profile;
if (Tìm thấy?) then (có)
  :Chọn hồ sơ hiện có;
else (không)
  :Nhập họ tên, ngày sinh
và email (nếu có);
  :Tạo Patient Profile;
endif
:Chọn dịch vụ, bác sĩ và thời gian;
:Kiểm tra năng lực bác sĩ, ca làm việc,
unavailable và xung đột lịch;
if (Hợp lệ?) then (có)
  :Tạo lịch CONFIRMED;
  :Giữ slot bác sĩ;
  :Tạo thông báo cho bệnh nhân
và bác sĩ được gán;
else (không)
  :Không tạo lịch;
endif
stop
@enduml
