@startuml
title UF-01. Tài khoản và xác thực

skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 0
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle diamond

start
:Nhập SĐT;
:Hệ thống tra cứu hồ sơ và account;
if (Account ACTIVE?) then (có)
  :Nhập mật khẩu;
  if (Mật khẩu đúng?) then (có)
    :Mở chức năng theo role;
  else (không)
    :Từ chối đăng nhập;
  endif
  stop
else (không)
endif
if (Account chờ kích hoạt?) then (có)
  :Gửi OTP đến SĐT;
  :Xác minh OTP;
  if (Hợp lệ?) then (có)
    :Đặt mật khẩu;
    :Kích hoạt account;
  else (không)
    :Từ chối kích hoạt;
  endif
  stop
else (không)
endif
if (Đã có Patient Profile?) then (có)
  :Gửi OTP đến SĐT;
  :Xác minh OTP;
  if (Hợp lệ?) then (có)
    :Đặt mật khẩu;
    :Tạo account cho hồ sơ hiện có;
  else (không)
    :Từ chối kích hoạt;
  endif
else (không)
  :Nhập họ tên, ngày sinh
và email (nếu có);
  :Gửi OTP đến SĐT;
  :Xác minh OTP;
  if (Hợp lệ?) then (có)
    :Đặt mật khẩu;
    :Tạo Patient Profile và account;
  else (không)
    :Không tạo tài khoản;
  endif
endif
stop
@enduml
