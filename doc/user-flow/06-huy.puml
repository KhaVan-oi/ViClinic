@startuml
title UF-06. Hủy lịch

skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 0
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle diamond

start
if (Người hủy?) then (Bệnh nhân)
  :Chọn lịch PENDING/CONFIRMED của mình;
  if (Còn ít nhất 2 giờ?) then (không)
    :Từ chối tự hủy;
    stop
  else (có)
  endif
else (Lễ tân)
  :Chọn lịch PENDING/CONFIRMED cần hủy;
endif
:Chuyển sang CANCELLED;
:Giải phóng slot bác sĩ nếu có;
:Ghi lịch sử thay đổi;
:Tạo thông báo cho bệnh nhân
và bác sĩ được gán;
stop
@enduml
