@startuml
title UF-03. Đặt lịch

skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 0
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle diamond

start
if (Người đặt?) then (Bệnh nhân)
  :Dùng Patient Profile của account đang đăng nhập;
else (Lễ tân)
  :Nhập SĐT bệnh nhân;
  :Hệ thống tra cứu Patient Profile;
  if (Tìm thấy?) then (có)
    :Chọn hồ sơ hiện có;
  else (không)
    :Nhập họ tên, ngày sinh
và email (nếu có);
    :Tạo Patient Profile;
  endif
endif
:Chọn dịch vụ;
:Chọn thời gian và bác sĩ (tùy chọn);
:Kiểm tra thời hạn đặt và trùng lịch bệnh nhân;
if (Đã chọn bác sĩ?) then (có)
  :Kiểm tra năng lực, ca làm việc,
unavailable và trùng lịch bác sĩ;
else (không)
  :Kiểm tra còn bác sĩ phù hợp tại thời điểm đó;
endif
if (Hợp lệ?) then (có)
  :Tạo lịch PENDING;
  if (Có bác sĩ?) then (có)
    :Giữ slot bác sĩ;
  else (không)
  endif
else (không)
  :Không tạo lịch;
endif
stop
@enduml
