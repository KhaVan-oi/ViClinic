@startuml
title UF-00. Luồng tổng quan

skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 0
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle diamond

start
:Chuẩn bị dịch vụ và lịch bác sĩ;
:Bệnh nhân hoặc lễ tân chọn dịch vụ,
thời gian và bác sĩ (tùy chọn);
:Kiểm tra điều kiện đặt lịch;
if (Hợp lệ?) then (có)
  :Tạo PENDING;
else (không)
  :Từ chối tạo lịch;
  stop
endif
if (Đã có bác sĩ?) then (có)
  :Giữ slot bác sĩ;
else (không)
endif
:Lễ tân xác nhận và gán bác sĩ nếu cần;
:Chuyển CONFIRMED;
if (Có thay đổi?) then (đổi lịch)
  :Lễ tân đổi bác sĩ hoặc thời gian;
elseif (hủy) then (hủy)
  :Chuyển CANCELLED;
  stop
else (không)
endif
:Bác sĩ hoặc lễ tân hoàn thành lịch;
:Chuyển COMPLETED;
stop
@enduml
