@startuml
title UF-02. Chuẩn bị dịch vụ và lịch bác sĩ

skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 0
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle diamond

start
:Quản lý tạo/cập nhật dịch vụ
và thời lượng khám;
:Gán bác sĩ có thể thực hiện từng dịch vụ;
:Quản lý tạo hoặc sửa ca làm việc;
if (Ca bị chồng lấn?) then (có)
  :Từ chối lưu ca;
  stop
else (không)
endif
if (Bác sĩ có thời gian không sẵn sàng?) then (có)
  :Bác sĩ khai báo khoảng không sẵn sàng;
else (không)
endif
if (Có lịch CONFIRMED bị ảnh hưởng?) then (có)
  :Đưa lịch bị ảnh hưởng vào danh sách xử lý;
  :Lễ tân đổi hoặc hủy lịch;
else (không)
endif
stop
@enduml
