@startuml
title UF-05. Đổi lịch

skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 0
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle diamond

start
:Lễ tân chọn lịch chưa kết thúc;
:Chọn bác sĩ hoặc thời gian mới;
:Kiểm tra lại điều kiện lịch;
if (Hợp lệ?) then (có)
  :Cập nhật trên cùng Appointment;
  :Cập nhật slot bác sĩ;
  :Ghi lịch sử thay đổi;
  :Tạo thông báo cho các bên liên quan;
else (không)
  :Giữ nguyên lịch hiện tại;
endif
stop
@enduml
