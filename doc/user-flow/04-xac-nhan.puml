@startuml
title UF-04. Xác nhận lịch

skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 0
skinparam conditionStyle InsideDiamond
skinparam conditionEndStyle diamond

start
:Lễ tân chọn lịch PENDING;
if (Đã có bác sĩ?) then (không)
  :Chọn bác sĩ phù hợp;
else (có)
endif
:Kiểm tra lại điều kiện lịch;
if (Hợp lệ?) then (có)
  :Chuyển sang CONFIRMED;
  :Ghi lịch sử thay đổi;
  :Tạo thông báo cho bệnh nhân
và bác sĩ được gán;
else (không)
  :Giữ nguyên PENDING;
endif
stop
@enduml
